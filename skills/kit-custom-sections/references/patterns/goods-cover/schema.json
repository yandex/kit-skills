{
  "title": "",
  "type": "object",
  "properties": {
    "palette": {
      "$ref": "#/definitions/Palette",
      "title": "Палитра цветов"
    },
    "source": {
      "$ref": "#/definitions/ProductsSource",
      "title": "Товары"
    },
    "cover": {
      "type": "object",
      "title": "Обложка",
      "required": [
        "title"
      ],
      "properties": {
        "title": {
          "type": "string",
          "title": "Заголовок",
          "default": ""
        },
        "description": {
          "$ref": "#/definitions/MarkdownContent",
          "title": "Описание"
        },
        "buttonText": {
          "type": "string",
          "title": "Подпись кнопки",
          "description": "Например «Все бестселлеры». Кнопка видна, когда заданы и подпись, и ссылка",
          "default": ""
        },
        "url": {
          "$ref": "#/definitions/LinkSource",
          "title": "Ссылка кнопки"
        }
      }
    },
    "count": {
      "type": "number",
      "title": "Сколько товаров в карусели",
      "unit": "шт.",
      "step": 1,
      "minimum": 3,
      "maximum": 8,
      "default": 6
    },
    "columnsTouch": {
      "type": "number",
      "title": "Карточек в ряду на телефоне",
      "step": 1,
      "minimum": 1,
      "maximum": 2,
      "default": 2
    },
    "coverSide": {
      "type": "string",
      "title": "Обложка на компьютере",
      "enum": [
        "left",
        "right"
      ],
      "options": [
        "Слева от полки",
        "Справа от полки"
      ],
      "default": "left"
    },
    "section": {
      "type": "object",
      "title": "Размеры секции",
      "required": [
        "isFullscreen",
        "paddingTop",
        "paddingBottom"
      ],
      "properties": {
        "isFullscreen": {
          "$ref": "#/definitions/OptionalFlag",
          "title": "Растянуть секцию на весь экран"
        },
        "hPaddingDesktop": {
          "$ref": "#/definitions/SectionHPadding",
          "title": "Отступ по краям на десктопе"
        },
        "hPaddingMobile": {
          "$ref": "#/definitions/SectionHPaddingTouch",
          "title": "Отступ по краям на телефоне"
        },
        "paddingTop": {
          "$ref": "#/definitions/SectionVPadding",
          "title": "Отступ над секцией"
        },
        "paddingBottom": {
          "$ref": "#/definitions/SectionVPadding",
          "title": "Отступ под секцией"
        }
      }
