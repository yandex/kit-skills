{
  "title": "Ответы для сборки FAQ-аккордеона",
  "type": "object",
  "properties": {
    "titleText": {
      "type": "string",
      "title": "Заголовок секции"
    },
    "titleAlign": {
      "type": "string",
      "enum": [
        "default",
        "left",
        "center"
      ],
      "title": "Расположение заголовка"
    },
    "palette": {
      "type": "string",
      "title": "Палитра (id из настроек магазина)"
    },
    "modules": {
      "type": "array",
      "title": "Вопросы и ответы",
      "items": {
        "type": "object",
        "properties": {
          "question": {
            "type": "string",
            "title": "Вопрос"
          },
          "answer": {
            "type": "string",
            "title": "Ответ (markdown)"
          }
        },
        "required": [
          "question",
          "answer"
        ]
      }
    },
    "verticalRhythm": {
      "type": "string",
      "title": "Вертикальный отступ блока (spacing-токен, например 500 = 40px с каждой стороны)"
    },
    "verticalRhythmTouch": {
      "type": "string",
      "title": "Вертикальный отступ на телефоне (spacing-токен)"
    }
  },
  "required": [
    "titleText",
    "modules"
  ]
}
