{
  "title": "",
  "type": "object",
  "properties": {
    "cta": {
      "type": "object",
      "title": "Кнопка или ссылка дальше",
      "properties": {
        "text": {
          "type": "string",
          "title": "Подпись: куда ведёт («Все условия доставки»)",
          "default": ""
        },
        "link": {
          "$ref": "#/definitions/LinkSource",
          "title": "Ссылка"
        },
        "style": {
          "type": "string",
          "title": "Вид",
          "enum": [
            "button",
            "link"
          ],
          "options": [
            "Кнопка",
            "Ссылка со стрелкой"
          ],
          "default": "button"
        }
      }
    },
    "descriptionTone": {
      "type": "string",
      "title": "Цвет описаний",
      "enum": [
        "primary",
        "secondary"
      ],
      "options": [
        "Основной — контрастный",
        "Приглушённый — только тёмный текст на светлом фоне"
      ],
      "default": "primary"
    },
    "palette": {
      "$ref": "#/definitions/Palette",
      "title": "Палитра цветов"
    },
    "titleText": {
      "type": "string",
      "title": "Заголовок",
      "default": ""
    },
    "titleAlign": {
      "$ref": "#/definitions/SectionTitleAlign",
      "title": "Расположение заголовка"
    },
    "leadText": {
      "$ref": "#/definitions/TextArea",
      "title": "Вводный текст под заголовком"
    },
    "numbering": {
      "type": "string",
      "title": "Нумерация шагов",
      "enum": [
        "leading-zero",
        "number",
        "none"
      ],
      "options": [
        "01, 02, 03",
        "1, 2, 3",
        "Без номеров"
      ],
      "default": "leading-zero"
    },
    "style": {
      "type": "string",
      "title": "Оформление шага",
      "enum": [
        "cards",
        "plain"
      ],
      "options": [
        "Карточки на подложке",
        "Без подложки, линия сверху"
      ],
      "default": "cards"
    },
    "desktopLayout": {
      "type": "string",
      "title": "Раскладка на компьютере",
      "enum": [
        "grid",
        "list"
      ],
      "options": [
        "Сетка в ряд",
        "Список строк"
      ],
      "default": "grid"
    },
    "columns": {
      "type": "string",
      "title": "Колонок в сетке",
      "enum": [
        "auto",
        "2",
        "3",
        "4",
        "5"
      ],
      "options": [
        "По числу шагов",
        "2",
        "3",
        "4",
        "5"
      ],
      "default": "auto"
    },
    "mobileMode": {
      "type": "string",
      "title": "Раскладка на телефоне",
      "enum": [
        "stack",
        "scroll"
      ],
      "options": [
        "Друг под другом",
        "Лента с прокруткой"
      ],
      "default": "stack"
    },
    "noteText": {
      "$ref": "#/definitions/TextArea",
      "title": "Сноска под шагами"
    },
    "section": {
      "type": "object",
      "title": "Размеры секции",
      "required": [
        "isFullscreen",
        "paddingTop",
        "paddingBottom"
      ],
      "properties": {
        "isFullscreen": {
          "$ref": "#/definitions/OptionalFlag",
          "title": "Растянуть секцию на весь экран"
        },
        "hPaddingDesktop": {
          "$ref": "#/definitions/SectionHPadding",
          "title": "Отступ по краям на десктопе"
        },
        "hPaddingMobile": {
          "$ref": "#/definitions/SectionHPaddingTouch",
          "title": "Отступ по краям на телефоне"
        },
        "paddingTop": {
          "$ref": "#/definitions/SectionVPadding",
          "title": "Отступ над секцией"
        },
        "paddingBottom": {
          "$ref": "#/definitions/SectionVPadding",
          "title": "Отступ под секцией"
        }
      }
    },
    "modules": {
      "type": "array",
      "title": "Шаги",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "title": "Название шага (без номера: номер ставится сам)",
            "default": ""
          },
          "text": {
            "$ref": "#/definitions/TextArea",
            "title": "Описание шага"
          },
          "image": {
            "$ref": "#/definitions/ImageModel",
            "title": "Изображение (необязательно)"
          },
          "imageAlt": {
            "type": "string",
            "title": "Описание изображения для незрячих и поиска (пусто — название шага)",
            "default": ""
          },
          "note": {
            "$ref": "#/definitions/TextArea",
            "title": "Примечание мелким шрифтом"
          }
        },
        "required": [
          "title"
        ]
      }
    },
    "verticalRhythm": {
      "type": "string",
      "enum": [
        "0",
        "25",
        "50",
        "75",
        "100",
        "150",
        "200",
        "250",
        "300",
        "350",
        "400",
        "450",
        "500",
        "600",
        "700",
        "800",
        "900",
        "1000",
        "1100",
        "1200",
        "1300",
        "1400",
        "1500",
        "1600",
        "1700",
        "1800",
        "1900",
        "2000"
      ],
      "title": "Добавочный вертикальный отступ блока сверх отступов секции (токен темы, с каждой стороны; 0 — как у нативных соседей, больше — только намеренный разрыв главы)",
      "default": "0"
    },
    "verticalRhythmTouch": {
      "type": "string",
      "enum": [
        "0",
        "25",
        "50",
        "75",
        "100",
        "150",
        "200",
        "250",
        "300",
        "350",
        "400",
        "450",
        "500",
        "600",
        "700",
        "800",
        "900",
        "1000",
        "1100",
        "1200",
        "1300",
        "1400",
        "1500",
        "1600",
        "1700",
        "1800",
        "1900",
        "2000"
      ],
      "title": "Добавочный вертикальный отступ на телефоне (токен темы; 0 — как у нативных соседей)",
      "default": "0"
    }
  },
  "required": [
    "section",
    "modules"
  ]
}
