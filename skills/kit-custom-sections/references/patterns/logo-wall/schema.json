{
  "title": "",
  "type": "object",
  "properties": {
    "palette": {
      "$ref": "#/definitions/Palette",
      "title": "Палитра цветов"
    },
    "titleText": {
      "type": "string",
      "title": "Заголовок",
      "default": ""
    },
    "titleAlign": {
      "$ref": "#/definitions/SectionTitleAlign",
      "title": "Расположение заголовка"
    },
    "layout": {
      "type": "string",
      "title": "Раскладка",
      "enum": [
        "grid",
        "marquee"
      ],
      "options": [
        "Сетка",
        "Бегущая строка"
      ],
      "default": "grid"
    },
    "columns": {
      "type": "string",
      "title": "Колонок в сетке на компьютере",
      "enum": [
        "3",
        "4",
        "5",
        "6"
      ],
      "default": "5"
    },
    "columnsTouch": {
      "type": "string",
      "title": "Колонок в сетке на телефоне",
      "enum": [
        "2",
        "3"
      ],
      "default": "2"
    },
    "logoHeight": {
      "type": "string",
      "title": "Высота логотипа",
      "enum": [
        "600",
        "800",
        "1000",
        "1200"
      ],
      "options": [
        "48 px",
        "64 px",
        "80 px",
        "112 px"
      ],
      "default": "800"
    },
    "tileBackground": {
      "type": "string",
      "title": "Подложка логотипа",
      "enum": [
        "none",
        "neutral"
      ],
      "options": [
        "Без подложки",
        "Нейтральная плитка"
      ],
      "default": "none"
    },
    "grayscale": {
      "type": "boolean",
      "title": "Логотипы в монохроме, цвет при наведении",
      "default": false
    },
    "speed": {
      "type": "string",
      "title": "Скорость бегущей строки",
      "enum": [
        "slow",
        "normal",
        "fast"
      ],
      "options": [
        "Медленно",
        "Обычно",
        "Быстро"
      ],
      "default": "normal"
    },
    "pauseOnHover": {
      "type": "boolean",
      "title": "Останавливать бегущую строку при наведении",
      "default": true
    },
    "fadeEdges": {
      "type": "boolean",
      "title": "Растворять края бегущей строки",
      "default": true
    },
    "section": {
      "type": "object",
      "title": "Размеры секции",
      "required": [
        "isFullscreen",
        "paddingTop",
        "paddingBottom"
      ],
      "properties": {
        "isFullscreen": {
          "$ref": "#/definitions/OptionalFlag",
          "title": "Растянуть секцию на весь экран"
        },
        "hPaddingDesktop": {
          "$ref": "#/definitions/SectionHPadding",
          "title": "Отступ по краям на десктопе"
        },
        "hPaddingMobile": {
          "$ref": "#/definitions/SectionHPaddingTouch",
          "title": "Отступ по краям на телефоне"
        },
        "paddingTop": {
          "$ref": "#/definitions/SectionVPadding",
          "title": "Отступ над секцией"
        },
        "paddingBottom": {
          "$ref": "#/definitions/SectionVPadding",
          "title": "Отступ под секцией"
        }
      }
    },
    "modules": {
      "type": "array",
      "title": "Логотипы",
      "items": {
        "type": "object",
        "properties": {
          "image": {
            "$ref": "#/definitions/ImageModel",
            "title": "Логотип (лучше PNG с прозрачным фоном)"
          },
          "name": {
            "type": "string",
            "title": "Название: описание логотипа для незрячих и текст, пока логотип не загружен",
            "default": ""
          },
          "link": {
            "$ref": "#/definitions/LinkSource",
            "title": "Ссылка (работает только в сетке)"
          },
          "caption": {
            "$ref": "#/definitions/TextArea",
            "title": "Подпись под логотипом (только в сетке)"
          }
        },
        "required": [
          "name"
        ]
      }
    },
    "verticalRhythm": {
      "type": "string",
      "enum": [
        "0",
        "25",
        "50",
        "75",
        "100",
        "150",
        "200",
        "250",
        "300",
        "350",
        "400",
        "450",
        "500",
        "600",
        "700",
        "800",
        "900",
        "1000",
        "1100",
        "1200",
        "1300",
        "1400",
        "1500",
        "1600",
        "1700",
        "1800",
        "1900",
        "2000"
      ],
      "title": "Добавочный вертикальный отступ блока сверх отступов секции (токен темы, с каждой стороны; 0 — как у нативных соседей, больше — только намеренный разрыв главы)",
      "default": "0"
    },
    "verticalRhythmTouch": {
      "type": "string",
      "enum": [
        "0",
        "25",
        "50",
        "75",
        "100",
        "150",
        "200",
        "250",
        "300",
        "350",
        "400",
        "450",
        "500",
        "600",
        "700",
        "800",
        "900",
        "1000",
        "1100",
        "1200",
        "1300",
        "1400",
        "1500",
        "1600",
        "1700",
        "1800",
        "1900",
        "2000"
      ],
      "title": "Добавочный вертикальный отступ на телефоне (токен темы; 0 — как у нативных соседей)",
      "default": "0"
    }
  },
  "required": [
    "section",
    "modules"
  ]
}
