{
  "title": "Ответы для секции до/после",
  "type": "object",
  "properties": {
    "titleText": {
      "type": "string",
      "title": "Заголовок секции"
    },
    "titleAlign": {
      "type": "string",
      "enum": [
        "default",
        "left",
        "center"
      ],
      "title": "Расположение заголовка"
    },
    "palette": {
      "type": "string",
      "title": "Палитра (id из настроек магазина)"
    },
    "before": {
      "type": "object",
      "title": "Изображение «до»",
      "properties": {
        "image": {
          "$ref": "#/definitions/ImageModel",
          "title": "Изображение: {fileId, filePath}. Из вывода kit.py media upload берётся fileId = поле `id`, filePath = `public_path` — как есть вывод не вставлять"
        }
      }
    },
    "after": {
      "type": "object",
      "title": "Изображение «после»",
      "properties": {
        "image": {
          "$ref": "#/definitions/ImageModel",
          "title": "Изображение: {fileId, filePath}. Из вывода kit.py media upload берётся fileId = поле `id`, filePath = `public_path` — как есть вывод не вставлять"
        }
      }
    },
    "verticalRhythm": {
      "type": "string",
      "title": "Вертикальный отступ блока (spacing-токен, например 500 = 40px с каждой стороны)"
    },
    "verticalRhythmTouch": {
      "type": "string",
      "title": "Вертикальный отступ на телефоне (spacing-токен)"
    }
  },
  "required": [
    "titleText"
  ]
}
