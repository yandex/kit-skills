{
  "title": "",
  "type": "object",
  "properties": {
    "cta": {
      "type": "object",
      "title": "Кнопка или ссылка дальше",
      "properties": {
        "text": {
          "type": "string",
          "title": "Подпись: куда ведёт («Все условия доставки»)",
          "default": ""
        },
        "link": {
          "$ref": "#/definitions/LinkSource",
          "title": "Ссылка"
        },
        "style": {
          "type": "string",
          "title": "Вид",
          "enum": [
            "button",
            "link"
          ],
          "options": [
            "Кнопка",
            "Ссылка со стрелкой"
          ],
          "default": "button"
        }
      }
    },
    "descriptionTone": {
      "type": "string",
      "title": "Цвет описаний",
      "enum": [
        "primary",
        "secondary"
      ],
      "options": [
        "Основной — контрастный",
        "Приглушённый — только тёмный текст на светлом фоне"
      ],
      "default": "primary"
    },
    "palette": {
      "$ref": "#/definitions/Palette",
      "title": "Палитра цветов"
    },
    "titleText": {
      "type": "string",
      "title": "Заголовок",
      "default": ""
    },
    "titleAlign": {
      "$ref": "#/definitions/SectionTitleAlign",
      "title": "Расположение заголовка"
    },
    "columns": {
      "type": "number",
      "title": "Карточек в ряд на компьютере",
      "default": 3,
      "minimum": 2,
      "maximum": 4,
      "step": 1,
      "unit": "шт."
    },
    "columnsTouch": {
      "type": "number",
      "title": "Карточек в ряд на телефоне",
      "default": 1,
      "minimum": 1,
      "maximum": 2,
      "step": 1,
      "unit": "шт."
    },
    "hGap": {
      "type": "string",
      "title": "Зазор между карточками в ряду",
      "default": "300",
      "enum": [
        "0",
        "25",
        "50",
        "100",
        "150",
        "200",
        "250",
        "300",
        "400",
        "500",
        "600",
        "700"
      ]
    },
    "vGap": {
      "type": "string",
      "title": "Зазор между рядами",
      "default": "300",
      "enum": [
        "0",
        "25",
        "50",
        "100",
        "150",
        "200",
        "250",
        "300",
        "400",
        "500",
        "600",
        "700"
      ]
    },
    "section": {
      "type": "object",
      "title": "Размеры секции",
      "required": [
        "isFullscreen",
        "paddingTop",
        "paddingBottom"
      ],
      "properties": {
        "isFullscreen": {
          "$ref": "#/definitions/OptionalFlag",
          "title": "Растянуть секцию на весь экран"
        },
        "hPaddingDesktop": {
          "$ref": "#/definitions/SectionHPadding",
          "title": "Отступ по краям на десктопе"
        },
        "hPaddingMobile": {
          "$ref": "#/definitions/SectionHPaddingTouch",
          "title": "Отступ по краям на телефоне"
        },
        "paddingTop": {
          "$ref": "#/definitions/SectionVPadding",
          "title": "Отступ над секцией"
        },
        "paddingBottom": {
          "$ref": "#/definitions/SectionVPadding",
          "title": "Отступ под секцией"
        }
      }
    },
    "modules": {
      "type": "array",
      "title": "Карточки",
      "items": {
        "type": "object",
        "title": "Карточка",
        "properties": {
          "icon": {
            "$ref": "#/definitions/ImageModel",
            "title": "Иконка (необязательно, квадратная)"
          },
          "title": {
            "type": "string",
            "title": "Заголовок карточки",
            "default": ""
          },
          "description": {
            "$ref": "#/definitions/TextArea",
            "title": "Короткий текст на карточке (1–2 предложения)"
          },
          "ctaText": {
            "type": "string",
            "title": "Текст ссылки на подробности",
            "default": "Подробнее"
          },
          "details": {
            "type": "object",
            "title": "Шторка с подробностями (пустая — карточка без кнопки)",
            "properties": {
              "content": {
                "$ref": "#/definitions/MarkdownContent",
                "title": "Подробный текст: абзацы, списки, ссылки (заголовок шторки = заголовок карточки)"
              },
              "image": {
                "$ref": "#/definitions/ImageModel",
                "title": "Картинка под текстом (необязательно)"
              },
              "imageAlt": {
                "type": "string",
                "title": "Описание картинки для незрячих (пусто — заголовок карточки)",
                "default": ""
              }
            }
          }
        },
        "required": [
          "title"
        ]
      }
    },
    "verticalRhythm": {
      "type": "string",
      "enum": [
        "0",
        "25",
        "50",
        "75",
        "100",
        "150",
        "200",
        "250",
        "300",
        "350",
        "400",
        "450",
        "500",
        "600",
        "700",
        "800",
        "900",
        "1000",
        "1100",
        "1200",
        "1300",
        "1400",
        "1500",
        "1600",
        "1700",
        "1800",
        "1900",
        "2000"
      ],
      "title": "Добавочный вертикальный отступ блока сверх отступов секции (токен темы, с каждой стороны; 0 — как у нативных соседей, больше — только намеренный разрыв главы)",
      "default": "0"
    },
    "verticalRhythmTouch": {
      "type": "string",
      "enum": [
        "0",
        "25",
        "50",
        "75",
        "100",
        "150",
        "200",
        "250",
        "300",
        "350",
        "400",
        "450",
        "500",
        "600",
        "700",
        "800",
        "900",
        "1000",
        "1100",
        "1200",
        "1300",
        "1400",
        "1500",
        "1600",
        "1700",
        "1800",
        "1900",
        "2000"
      ],
      "title": "Добавочный вертикальный отступ на телефоне (токен темы; 0 — как у нативных соседей)",
      "default": "0"
    }
  },
  "required": [
    "section",
    "modules"
  ]
}
