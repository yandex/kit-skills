{
  "title": "",
  "type": "object",
  "properties": {
    "cta": {
      "type": "object",
      "title": "Кнопка или ссылка дальше",
      "properties": {
        "text": {
          "type": "string",
          "title": "Подпись: куда ведёт («Все условия доставки»)",
          "default": ""
        },
        "link": {
          "$ref": "#/definitions/LinkSource",
          "title": "Ссылка"
        },
        "style": {
          "type": "string",
          "title": "Вид",
          "enum": [
            "button",
            "link"
          ],
          "options": [
            "Кнопка",
            "Ссылка со стрелкой"
          ],
          "default": "button"
        }
      }
    },
    "descriptionTone": {
      "type": "string",
      "title": "Цвет описаний",
      "enum": [
        "primary",
        "secondary"
      ],
      "options": [
        "Основной — контрастный",
        "Приглушённый — только тёмный текст на светлом фоне"
      ],
      "default": "primary"
    },
    "palette": {
      "$ref": "#/definitions/Palette",
      "title": "Палитра цветов"
    },
    "titleText": {
      "type": "string",
      "title": "Заголовок",
      "default": ""
    },
    "titleAlign": {
      "$ref": "#/definitions/SectionTitleAlign",
      "title": "Расположение заголовка"
    },
    "layout": {
      "type": "string",
      "title": "Раскладка",
      "enum": [
        "grid",
        "carousel"
      ],
      "options": [
        "Сетка",
        "Карусель со стрелками"
      ],
      "default": "grid"
    },
    "columns": {
      "type": "string",
      "title": "Колонок на компьютере",
      "enum": [
        "2",
        "3",
        "4",
        "6"
      ],
      "options": [
        "2 в ряд",
        "3 в ряд",
        "4 в ряд",
        "6 в ряд (только для коротких фраз)"
      ],
      "default": "4"
    },
    "tileRatio": {
      "type": "string",
      "title": "Форма плиток",
      "enum": [
        "auto",
        "3:4",
        "1:1",
        "4:3"
      ],
      "options": [
        "По содержимому",
        "Вертикальные 3:4",
        "Квадратные 1:1",
        "Горизонтальные 4:3"
      ],
      "default": "auto"
    },
    "decoration": {
      "type": "string",
      "title": "Номера на плитках",
      "enum": [
        "none",
        "index-number"
      ],
      "options": [
        "Без номеров",
        "Номера 01, 02, 03"
      ],
      "default": "none"
    },
    "layoutTouch": {
      "type": "string",
      "title": "Раскладка сетки на телефоне",
      "enum": [
        "auto",
        "list",
        "grid",
        "scroll"
      ],
      "options": [
        "Автоматически",
        "Друг под другом",
        "Две колонки",
        "Лента с прокруткой"
      ],
      "default": "list"
    },
    "columnsTouch": {
      "type": "string",
      "title": "Карточек на экране телефона (карусель и лента)",
      "enum": [
        "1",
        "2"
      ],
      "options": [
        "Одна и край следующей",
        "Две и край следующей"
      ],
      "default": "1"
    },
    "controlsAlignment": {
      "type": "string",
      "title": "Стрелки карусели на компьютере",
      "enum": [
        "edges",
        "leftRight",
        "left",
        "right",
        "none"
      ],
      "options": [
        "По краям карусели",
        "Внутри по краям",
        "Обе слева",
        "Обе справа",
        "Без стрелок"
      ],
      "default": "edges"
    },
    "noteText": {
      "$ref": "#/definitions/TextArea",
      "title": "Сноска под плитками (условия, оговорки)",
      "default": ""
    },
    "section": {
      "type": "object",
      "title": "Размеры секции",
      "required": [
        "isFullscreen",
        "paddingTop",
        "paddingBottom"
      ],
      "properties": {
        "isFullscreen": {
          "$ref": "#/definitions/OptionalFlag",
          "title": "Растянуть секцию на весь экран"
        },
        "hPaddingDesktop": {
          "$ref": "#/definitions/SectionHPadding",
          "title": "Отступ по краям на десктопе"
        },
        "hPaddingMobile": {
          "$ref": "#/definitions/SectionHPaddingTouch",
          "title": "Отступ по краям на телефоне"
        },
        "paddingTop": {
          "$ref": "#/definitions/SectionVPadding",
          "title": "Отступ над секцией"
        },
        "paddingBottom": {
          "$ref": "#/definitions/SectionVPadding",
          "title": "Отступ под секцией"
        }
      }
    },
    "modules": {
      "type": "array",
      "title": "Преимущества",
      "items": {
        "type": "object",
        "properties": {
          "surface": {
            "type": "string",
            "title": "Вид плитки",
            "enum": [
              "neutral",
              "none",
              "accent",
              "photo"
            ],
            "options": [
              "Нейтральный фон",
              "Без фона",
              "Акцент (цвет бренда)",
              "Фото на всю плитку"
            ],
            "default": "neutral"
          },
          "image": {
            "$ref": "#/definitions/ImageModel",
            "title": "Иконка или фото плитки (необязательно)"
          },
          "imageAlt": {
            "type": "string",
            "title": "Что на фото (обязательно для фото-плиток)",
            "default": ""
          },
          "icon": {
            "type": "string",
            "title": "Встроенная иконка (если своей картинки нет)",
            "enum": [
              "none",
              "delivery",
              "box",
              "shopping-bag",
              "shop",
              "location",
              "clock",
              "credit-card",
              "coins",
              "percent",
              "gift",
              "check",
              "star",
              "heart",
              "reload",
              "lock",
              "hanger",
              "phone",
              "user",
              "info"
            ],
            "options": [
              "Без иконки",
              "Доставка",
              "Коробка",
              "Пакет покупок",
              "Магазин",
              "Геолокация",
              "Часы",
              "Банковская карта",
              "Монеты",
              "Процент",
              "Подарок",
              "Галочка",
              "Звезда (залитая)",
              "Сердце (контуром)",
              "Обмен и возврат",
              "Замок",
              "Вешалка",
              "Телефон",
              "Человек",
              "Информация"
            ],
            "default": "none"
          },
          "title": {
            "type": "string",
            "title": "Заголовок плитки",
            "default": ""
          },
          "subtitle": {
            "type": "string",
            "title": "Акцентная строка под заголовком (необязательно)",
            "default": ""
          },
          "description": {
            "type": "string",
            "title": "Текст плитки",
            "default": ""
          },
          "list": {
            "$ref": "#/definitions/MarkdownContent",
            "title": "Список под текстом (markdown, необязательно)",
            "default": ""
          },
          "pairWithNext": {
            "type": "boolean",
            "title": "На телефоне в ленте: фото и следующая плитка — один свайп",
            "default": false
          }
        },
        "required": [
          "title",
          "description"
        ]
      }
    },
    "verticalRhythm": {
      "type": "string",
      "enum": [
        "0",
        "25",
        "50",
        "75",
        "100",
        "150",
        "200",
        "250",
        "300",
        "350",
        "400",
        "450",
        "500",
        "600",
        "700",
        "800",
        "900",
        "1000",
        "1100",
        "1200",
        "1300",
        "1400",
        "1500",
        "1600",
        "1700",
        "1800",
        "1900",
        "2000"
      ],
      "title": "Добавочный вертикальный отступ блока сверх отступов секции (токен темы, с каждой стороны; 0 — как у нативных соседей, больше — только намеренный разрыв главы)",
      "default": "0"
    },
    "verticalRhythmTouch": {
      "type": "string",
      "enum": [
        "0",
        "25",
        "50",
        "75",
        "100",
        "150",
        "200",
        "250",
        "300",
        "350",
        "400",
        "450",
        "500",
        "600",
        "700",
        "800",
        "900",
        "1000",
        "1100",
        "1200",
        "1300",
        "1400",
        "1500",
        "1600",
        "1700",
        "1800",
        "1900",
        "2000"
      ],
      "title": "Добавочный вертикальный отступ на телефоне (токен темы; 0 — как у нативных соседей)",
      "default": "0"
    }
  },
  "required": [
    "section",
    "modules"
  ]
}
