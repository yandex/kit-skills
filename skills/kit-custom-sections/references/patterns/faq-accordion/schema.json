{
  "title": "",
  "type": "object",
  "properties": {
    "cta": {
      "type": "object",
      "title": "Кнопка или ссылка дальше",
      "properties": {
        "text": {
          "type": "string",
          "title": "Подпись: куда ведёт («Все условия доставки»)",
          "default": ""
        },
        "link": {
          "$ref": "#/definitions/LinkSource",
          "title": "Ссылка"
        },
        "style": {
          "type": "string",
          "title": "Вид",
          "enum": [
            "button",
            "link"
          ],
          "options": [
            "Кнопка",
            "Ссылка со стрелкой"
          ],
          "default": "button"
        }
      }
    },
    "descriptionTone": {
      "type": "string",
      "title": "Цвет описаний",
      "enum": [
        "primary",
        "secondary"
      ],
      "options": [
        "Основной — контрастный",
        "Приглушённый — только тёмный текст на светлом фоне"
      ],
      "default": "primary"
    },
    "palette": {
      "$ref": "#/definitions/Palette",
      "title": "Палитра цветов"
    },
    "titleText": {
      "type": "string",
      "title": "Заголовок",
      "default": ""
    },
    "titleAlign": {
      "$ref": "#/definitions/SectionTitleAlign",
      "title": "Расположение заголовка"
    },
    "subtitleText": {
      "$ref": "#/definitions/TextArea",
      "title": "Подзаголовок (необязательно)"
    },
    "layout": {
      "type": "string",
      "title": "Раскладка вопросов",
      "enum": [
        "single",
        "two-columns"
      ],
      "options": [
        "Одна колонка",
        "Две колонки (на телефоне одна)"
      ],
      "default": "single"
    },
    "view": {
      "type": "string",
      "title": "Вид вопросов",
      "enum": [
        "dividers",
        "cards"
      ],
      "options": [
        "Линии между вопросами",
        "Карточки на подложке"
      ],
      "default": "dividers"
    },
    "answerLayout": {
      "type": "string",
      "title": "Где ответ (смещение — только в одной колонке, на телефоне ответ под вопросом)",
      "enum": [
        "below",
        "offset"
      ],
      "options": [
        "Под вопросом",
        "Со смещением: в правой половине"
      ],
      "default": "below"
    },
    "icon": {
      "type": "string",
      "title": "Иконка раскрытия",
      "enum": [
        "plus",
        "chevron"
      ],
      "options": [
        "Плюс и минус",
        "Стрелка"
      ],
      "default": "plus"
    },
    "expandFirst": {
      "type": "boolean",
      "title": "Первый вопрос открыт",
      "default": true
    },
    "section": {
      "type": "object",
      "title": "Размеры секции",
      "required": [
        "isFullscreen",
        "paddingTop",
        "paddingBottom"
      ],
      "properties": {
        "isFullscreen": {
          "$ref": "#/definitions/OptionalFlag",
          "title": "Растянуть секцию на весь экран"
        },
        "hPaddingDesktop": {
          "$ref": "#/definitions/SectionHPadding",
          "title": "Отступ по краям на десктопе"
        },
        "hPaddingMobile": {
          "$ref": "#/definitions/SectionHPaddingTouch",
          "title": "Отступ по краям на телефоне"
        },
        "paddingTop": {
          "$ref": "#/definitions/SectionVPadding",
          "title": "Отступ над секцией"
        },
        "paddingBottom": {
          "$ref": "#/definitions/SectionVPadding",
          "title": "Отступ под секцией"
        }
      }
    },
    "modules": {
      "type": "array",
      "title": "Вопросы и ответы",
      "items": {
        "type": "object",
        "properties": {
          "question": {
            "type": "string",
            "title": "Вопрос",
            "default": ""
          },
          "answer": {
            "$ref": "#/definitions/MarkdownContent",
            "title": "Ответ",
            "default": ""
          }
        },
        "required": [
          "question",
          "answer"
        ]
      }
    },
    "verticalRhythm": {
      "type": "string",
      "enum": [
        "0",
        "25",
        "50",
        "75",
        "100",
        "150",
        "200",
        "250",
        "300",
        "350",
        "400",
        "450",
        "500",
        "600",
        "700",
        "800",
        "900",
        "1000",
        "1100",
        "1200",
        "1300",
        "1400",
        "1500",
        "1600",
        "1700",
        "1800",
        "1900",
        "2000"
      ],
      "title": "Добавочный вертикальный отступ блока сверх отступов секции (токен темы, с каждой стороны; 0 — как у нативных соседей, больше — только намеренный разрыв главы)",
      "default": "0"
    },
    "verticalRhythmTouch": {
      "type": "string",
      "enum": [
        "0",
        "25",
        "50",
        "75",
        "100",
        "150",
        "200",
        "250",
        "300",
        "350",
        "400",
        "450",
        "500",
        "600",
        "700",
        "800",
        "900",
        "1000",
        "1100",
        "1200",
        "1300",
        "1400",
        "1500",
        "1600",
        "1700",
        "1800",
        "1900",
        "2000"
      ],
      "title": "Добавочный вертикальный отступ на телефоне (токен темы; 0 — как у нативных соседей)",
      "default": "0"
    }
  },
  "required": [
    "section",
    "modules"
  ]
}
