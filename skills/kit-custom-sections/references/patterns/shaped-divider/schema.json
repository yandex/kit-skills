      "title": "Фон этого блока",
      "enum": [
        "primary",
        "secondary",
        "neutral"
      ],
      "options": [
        "Основной",
        "Второстепенный",
        "Нейтральный"
      ],
      "default": "primary"
    },
    "backdropPalette": {
